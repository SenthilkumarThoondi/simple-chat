<h1>Chats</h1>

<div id="chats">
  <% @chats.each do |chat| %>
    <%= link_to chat_messages_path(chat) do %>
      <div id="chat_<%= chat.id %>" style="display: flex; gap: 20px; margin: 10px; cursor: pointer; background: #efefef;">
        <div>
          <%= image_tag chat.display_image(current_user), style: "width: 30px; height: 30px; object-fit: cover; border-radius: 50%" %>
        </div>
        <div>
          <h5 style="margin: 0;"><%= chat.display_name(current_user) %></h5>
          <p style="margin: 0;"><%= chat.messages.last&.content || "No messages yet" %></p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<%= link_to 'New Chat', new_chat_path, class: "btn btn-primary" %>
<%= link_to 'New Group', new_group_chat_path, class: "btn btn-primary" %>