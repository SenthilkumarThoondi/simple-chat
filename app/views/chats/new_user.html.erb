<%= link_to "back", chat_path(@chat) %>
<%= form_with model: @chat, url: join_new_user_chat_path do |f| %>
  <div class="form-group">
    <%= f.label :users, "Select Users" %>
    <%#= f.select :user_ids, options_for_select(@users.pluck(:username, :id)),
                 multiple: true, required: true, include_blank: false %>

    <%= f.collection_select :user_ids, @users, :id, :username, { multiple: true, class: "form-select" } %>
  </div>

  <div class="form-group">
    <%= f.submit "Save" %>
  </div>
<% end %>