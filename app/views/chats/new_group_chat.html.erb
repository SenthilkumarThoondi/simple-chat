<%= form_with model: @group_chat, url: create_group_chat_path do |f| %>
  <%= f.hidden_field :is_group, value: true %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :users, "Select Users" %>
    <%= f.select :user_ids, options_for_select(@users.pluck(:username, :id)),
                 multiple: true, required: true, include_blank: false %>
  </div>

  <div class="form-group">
    <%= f.submit "Create Group Chat" %>
  </div>
<% end %>