<%= turbo_stream_from "chat_#{ @chat.id }" %>
<%= link_to "back", chats_path %>
<h2>
  <%= image_tag @chat.display_image(current_user), style: "width: 30px; height: 30px; object-fit: cover; border-radius: 50%" %>
  <%= link_to @chat.display_name(current_user), chat_path(@chat) %>
</h2>
<p>
  <% if @chat.is_group? && @chat.owner %>
    <%= @chat.owner.username %> has started a group chat
  <% end %>
</p>

<div id="messages">
  <% @messages.each do |message| %>
    <% class_names =  message.sender_id == current_user.id ? 'message message-sender' : 'message' %>
    <%= render message, class_names: class_names %>
  <% end %>
</div>

<%= form_for [@chat, @message] do |f| %>
  <%= f.text_area :content %>
  <%= f.text_field :sender_id, value: current_user.id, type: "hidden" %>
  <%= f.submit "Send" %>
<% end %>